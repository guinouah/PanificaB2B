@model PanificaB2B.Web.Models.ClienteDetalhes
@{ ViewData["Title"] = Model.Cliente.Nome; }
<div class="page-heading"><div><span class="eyebrow">FICHA DO CLIENTE</span><h1>@Model.Cliente.Nome</h1><p>@Model.Cliente.Endereco</p></div>@if (User.IsInRole("Administrador") || User.IsInRole("GestorComercial")) { <a asp-action="Editar" asp-route-id="@Model.Cliente.Id" class="btn btn-outline-primary">Editar cadastro</a> }</div>
<div class="detail-strip"><span>Telefone<strong>@Model.Cliente.Telefone</strong></span><span>E-mail<strong>@Model.Cliente.Email</strong></span><span>Documento<strong>@Model.Cliente.Documento</strong></span><span>Situação<strong>@(Model.Cliente.Ativo ? "Ativo" : "Inativo")</strong></span></div>
<div class="section-heading"><h2>Situação financeira</h2><span class="date-label">Consulta em @Model.Divida.DataConsulta.ToString("dd/MM/yyyy")</span></div>
<div class="dashboard"><article><span>Principal em aberto</span><strong>@Model.Divida.PrincipalAberto.ToString("C")</strong><small>Saldo das parcelas não quitadas</small></article><article><span>Principal vencido</span><strong>@Model.Divida.PrincipalVencido.ToString("C")</strong><small>Parcelas com vencimento anterior à consulta</small></article><article><span>Valor para quitação</span><strong>@Model.Divida.ValorQuitacao.ToString("C")</strong><small>Inclui os encargos e descontos aplicáveis</small></article></div>
<section class="panel"><div class="panel-head"><div><h2>Última compra efetiva por produto</h2><p>Quantidade atendida e preço unitário da última venda válida.</p></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Produto</th><th>Data</th><th class="numeric">Quantidade atendida</th><th class="numeric">Preço unitário</th></tr></thead><tbody>@foreach (var c in Model.Compras) { <tr><td><strong>@c.Produto</strong></td><td>@c.Data.ToString("dd/MM/yyyy")</td><td class="numeric">@c.Quantidade.ToString("0.###")</td><td class="numeric">@c.PrecoUnitario.ToString("C")</td></tr> }</tbody></table></div>@if (Model.Compras.Count == 0) { <div class="empty-state"><strong>Ainda não há compras efetivas</strong><p>O histórico aparece após o primeiro faturamento.</p></div> }</section><a asp-action="Index">← Voltar aos clientes</a>
