@model FormCliente
@{ ViewData["Title"] = ViewData["Id"] is null ? "Novo cliente" : "Editar cliente"; }
<h1>@ViewData["Title"]</h1>
<form asp-action="@(ViewData["Id"] is null ? "Novo" : "Editar")" asp-route-id="@ViewData["Id"]" method="post" class="form-panel">
    <input asp-for="Entrada.Versao" type="hidden" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Entrada.Nome">Nome / razão social</label><input asp-for="Entrada.Nome" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Entrada.Documento">Documento</label><input asp-for="Entrada.Documento" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Entrada.Email">E-mail</label><input asp-for="Entrada.Email" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Entrada.Telefone">Telefone</label><input asp-for="Entrada.Telefone" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Entrada.Endereco">Endereço</label><input asp-for="Entrada.Endereco" class="form-control" /></div>
    <div class="mb-3"><label for="estado-cliente">Estado</label><select id="estado-cliente" class="form-select" data-client-state required><option value="">Selecione o estado</option>@foreach(var estado in Model.Estados.Where(e=>e.Ativo || Model.Cidades.Any(c=>c.Id==Model.Entrada.CidadeId && c.EstadoId==e.Id))){<option value="@estado.Id" selected="@(Model.Cidades.FirstOrDefault(c=>c.Id==Model.Entrada.CidadeId)?.EstadoId==estado.Id)">@estado.Nome · @estado.Sigla</option>}</select></div>
    <div class="mb-3"><label asp-for="Entrada.CidadeId">Cidade</label><select asp-for="Entrada.CidadeId" class="form-select" data-client-city required><option value="">Selecione</option>@foreach (var item in Model.Cidades) { <option value="@item.Id" data-estado="@item.EstadoId">@item.Nome</option> }</select></div>
    <div class="mb-3"><label asp-for="Entrada.TerritorioId">Território</label><select asp-for="Entrada.TerritorioId" class="form-select"><option value="">Selecione</option>@foreach (var item in Model.Territorios) { <option value="@item.Id">@item.Nome</option> }</select><small>A API verifica se a cidade pertence ao território.</small></div>
    <label class="check"><input asp-for="Entrada.Ativo" /> Ativo</label>
    <button type="submit" class="btn btn-primary">Salvar</button> <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>
