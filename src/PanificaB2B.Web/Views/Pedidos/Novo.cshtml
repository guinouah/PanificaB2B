@model PanificaB2B.Web.Models.FormPedido
@{ ViewData["Title"] = "Novo pedido"; var hoje = DateOnly.FromDateTime(DateTime.Today); }
<h1>Novo pedido</h1><p>Informe a quantidade desejada; o estoque será conferido no faturamento.</p>
<form asp-action="Novo" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden" /><input asp-for="CriadoEm" type="hidden" /><input asp-for="CondicaoVersao" type="hidden" />
<label asp-for="ClienteId">Cliente</label><select asp-for="ClienteId" required class="form-select"><option value="">Selecione</option>@foreach (var c in Model.Clientes) { <option value="@c.Id">@c.Nome</option> }</select>
<label asp-for="CondicaoPagamentoId">Condição de pagamento</label><select asp-for="CondicaoPagamentoId" data-versao-destino="CondicaoVersao" required class="form-select"><option value="">Selecione</option>@foreach (var c in Model.Condicoes) { <option value="@c.Id" data-versao="@c.Versao">@c.Nome</option> }</select>
<label asp-for="Observacao">Observação</label><input asp-for="Observacao" class="form-control" maxlength="300" />
<table class="table"><thead><tr><th>Produto</th><th>Preço unitário</th><th>Quantidade</th></tr></thead><tbody>
@for (var i = 0; i < Model.Itens.Count; i++) { var produto = Model.Produtos.FirstOrDefault(x => x.Id == Model.Itens[i].ProdutoId); <tr class="@(produto?.EmPromocao(hoje) == true ? "promocao" : produto?.Novidade(hoje) == true ? "novidade" : "")"><td>@produto?.Nome (@produto?.Unidade) @if (produto?.EmPromocao(hoje) == true) { <strong>Promoção</strong> } @if (produto?.Novidade(hoje) == true) { <strong>Novo</strong> }<input asp-for="Itens[i].ProdutoId" type="hidden" /><input asp-for="Itens[i].ProdutoVersao" type="hidden" /><input asp-for="Itens[i].PrecoUnitario" type="hidden" /></td><td>@Model.Itens[i].PrecoUnitario.ToString("C")</td><td><input asp-for="Itens[i].Quantidade" type="number" min="0" step="0.001" class="form-control" /></td></tr> }
</tbody></table><button class="btn btn-primary">Confirmar pedido</button> <a asp-action="Index">Voltar</a></form>
