@model List<PanificaB2B.Contratos.ProdutoDto>
@{ ViewData["Title"] = "Produtos"; var hoje = DateOnly.FromDateTime(DateTime.Today); }
<div class="page-heading"><h1>Produtos</h1><a class="btn btn-primary" asp-action="Novo">Novo produto</a></div>
<p>Preços por unidade de venda. Promoções aparecem em amarelo; novidades, em azul.</p>
<table class="table"><thead><tr><th>Código / produto</th><th>Grupo</th><th>Unidade</th><th>Preço vigente</th><th>Situação</th><th></th></tr></thead><tbody>
@foreach (var p in Model) {
<tr class="@(p.EmPromocao(hoje) ? "promocao" : p.Novidade(hoje) ? "novidade" : "")"><td>@p.Codigo · @p.Nome @if (p.EmPromocao(hoje)) { <strong>Promoção</strong> } @if (p.Novidade(hoje)) { <strong>Novo</strong> }</td><td>@p.Grupo</td><td>@p.Unidade</td><td>@p.PrecoNaData(hoje).ToString("C")</td><td>@(p.Ativo ? "Ativo" : "Inativo")</td><td><a asp-action="Editar" asp-route-id="@p.Id">Editar</a></td></tr>
}
</tbody></table>
@if (Model.Count == 0) { <p>Cadastre primeiro um grupo e depois o produto.</p> }
