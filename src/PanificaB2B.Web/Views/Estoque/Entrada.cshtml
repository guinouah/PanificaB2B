@model PanificaB2B.Web.Models.FormEntradaEstoque
@{ ViewData["Title"] = "Entrada de estoque"; }
<h1>Entrada de estoque</h1><form asp-action="Entrada" method="post" class="form-panel">
<div asp-validation-summary="All" class="text-danger"></div><input asp-for="Entrada.Id" type="hidden" />
<label asp-for="Entrada.ProdutoId">Produto</label><select asp-for="Entrada.ProdutoId" class="form-select" required><option value="">Selecione</option>@foreach (var p in Model.Produtos.Where(x => x.Ativo)) { <option value="@p.Id">@p.Nome (@p.Unidade)</option> }</select>
<label asp-for="Entrada.CodigoLote">Lote</label><input asp-for="Entrada.CodigoLote" class="form-control" required maxlength="60" />
<label asp-for="Entrada.Validade">Validade</label><input asp-for="Entrada.Validade" type="date" class="form-control" required />
<label asp-for="Entrada.Quantidade">Quantidade</label><input asp-for="Entrada.Quantidade" type="number" step="0.001" min="0.001" class="form-control" required />
<button class="btn btn-primary">Registrar entrada</button> <a asp-action="Index">Voltar</a></form>
