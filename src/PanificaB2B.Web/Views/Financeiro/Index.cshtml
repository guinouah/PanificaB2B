@model PanificaB2B.Web.Models.FinanceiroModel
@{ ViewData["Title"] = "Contas a receber"; var abertos = Model.Titulos.Where(x => !x.Pago && !x.Cancelado).ToList(); }
<h1>Contas a receber</h1><form method="get" class="inline-form"><label>Data de cálculo <input type="date" name="data" value="@Model.Data.ToString("yyyy-MM-dd")" required class="form-control" /></label><button class="btn btn-outline-primary">Recalcular</button></form>
<p>Principal em aberto: <strong>@abertos.Sum(x => x.SaldoPrincipal).ToString("C")</strong> · vencido: <strong>@abertos.Where(x => x.Vencimento < Model.Data).Sum(x => x.SaldoPrincipal).ToString("C")</strong> · quitação nesta data: <strong>@abertos.Sum(x => x.ValorQuitacao).ToString("C")</strong></p>
<table class="table"><thead><tr><th>Título / cliente</th><th>Vencimento</th><th>Original</th><th>Multa / juros / desconto</th><th>Quitação</th><th>Situação</th><th></th></tr></thead><tbody>
@foreach (var t in Model.Titulos) { <tr class="@(!t.Pago && !t.Cancelado && t.Vencimento < Model.Data ? "vencido" : "")"><td>@t.Identificacao · @t.Cliente</td><td>@t.Vencimento.ToString("dd/MM/yyyy")</td><td>@t.ValorOriginal.ToString("C")</td><td>@t.Multa.ToString("C") / @t.Juros.ToString("C") / @t.Desconto.ToString("C")</td><td>@t.ValorQuitacao.ToString("C")</td><td>@(t.Cancelado ? "Cancelado" : t.Pago ? "Pago" : t.Vencimento < Model.Data ? "Vencido" : "Aberto")</td><td>@if (!t.Pago && !t.Cancelado) { <a asp-action="Receber" asp-route-id="@t.Id" asp-route-data="@Model.Data.ToString("yyyy-MM-dd")">Receber</a> } <a asp-controller="Vendas" asp-action="Detalhe" asp-route-id="@t.VendaId">Venda</a></td></tr> }
</tbody></table>
<h2>Recebimentos registrados</h2><table class="table"><thead><tr><th>Data</th><th>Título</th><th>Principal</th><th>Encargos</th><th>Desconto</th><th>Recebido</th><th>Forma</th></tr></thead><tbody>
@foreach (var r in Model.Recebimentos) { <tr><td>@r.Data.ToString("dd/MM/yyyy")</td><td>@Model.Titulos.FirstOrDefault(x => x.Id == r.TituloId)?.Identificacao</td><td>@r.Principal.ToString("C")</td><td>@((r.Multa + r.Juros).ToString("C"))</td><td>@r.Desconto.ToString("C")</td><td>@r.Valor.ToString("C")</td><td>@r.FormaPagamento</td></tr> }
</tbody></table>
