@model PanificaB2B.Web.Models.FormRoteiro
@{ ViewData["Title"] = "Organizar roteiro"; string[] dias = ["Domingo", "Segunda", "Terça", "Quarta", "Quinta", "Sexta", "Sábado"]; }
<h1>Organizar roteiro</h1><form method="post" asp-action="@ViewData["Acao"]" asp-route-id="@ViewData["Id"]" class="form-panel">
<div asp-validation-summary="All" class="text-danger"></div><input asp-for="Entrada.Versao" type="hidden" />
<label asp-for="Entrada.Nome">Nome</label><input asp-for="Entrada.Nome" required maxlength="150" class="form-control" />
<label asp-for="Entrada.VendedorId">Vendedor</label><select asp-for="Entrada.VendedorId" class="form-select" required><option value="">Selecione</option>@foreach (var v in Model.Vendedores) { <option value="@v.Id">@v.Nome</option> }</select>
<label asp-for="Entrada.DiaSemana">Dia</label><select asp-for="Entrada.DiaSemana" class="form-select">@for (var i = 0; i < 7; i++) { <option value="@i">@dias[i]</option> }</select>
<p>Use posições 10, 20, 30; para inserir entre 10 e 20, use 15. A API confere a carteira do vendedor.</p>
<div data-linhas="visitas" data-prefixo="Entrada.Visitas">@for (var i = 0; i < Model.Entrada.Visitas.Count; i++) { <div data-linha class="inline-form"><label>Sequência <input asp-for="Entrada.Visitas[i].Sequencia" type="number" min="1" required class="form-control" /></label><label>Cliente <select asp-for="Entrada.Visitas[i].ClienteId" required class="form-select"><option value="">Selecione</option>@foreach (var c in Model.Clientes.Where(x => x.Ativo || x.Id == Model.Entrada.Visitas[i].ClienteId)) { <option value="@c.Id">@c.Nome</option> }</select></label><button type="button" data-remover class="btn btn-outline-secondary">Remover</button></div> }</div>
<template id="visita-template"><div data-linha class="inline-form"><label>Sequência <input name="Entrada.Visitas[__i__].Sequencia" type="number" min="1" required class="form-control" /></label><label>Cliente <select name="Entrada.Visitas[__i__].ClienteId" required class="form-select"><option value="">Selecione</option>@foreach (var c in Model.Clientes.Where(x => x.Ativo)) { <option value="@c.Id">@c.Nome</option> }</select></label><button type="button" data-remover class="btn btn-outline-secondary">Remover</button></div></template>
<button type="button" data-adicionar="visitas" data-template="visita-template" class="btn btn-outline-primary">Adicionar visita</button><label class="check"><input asp-for="Entrada.Ativo" /> Ativo</label><button class="btn btn-primary">Salvar roteiro</button> <a asp-action="Index">Voltar</a></form>
