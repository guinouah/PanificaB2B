@model PanificaB2B.Web.Models.CadastrosModel
@using PanificaB2B.Contratos
@{ ViewData["Title"] = "Cadastros"; }
<h1>Cadastros da distribuidora</h1><p>Cadastre estados, cidades, vendedores e territórios nesta ordem. Abra os registros existentes para editar ou inativar.</p>
<h2>Estados</h2>
@foreach (var e in Model.Estados.Append(new EstadoDto(Guid.Empty, "", "", true))) { <details><summary>@(e.Id == Guid.Empty ? "+ Novo estado" : e.Sigla + " · " + e.Nome + (e.Ativo ? "" : " (inativo)"))</summary><form asp-action="Estado" method="post" class="inline-form"><input name="id" type="hidden" value="@(e.Id == Guid.Empty ? "" : e.Id.ToString())" /><label>Nome <input name="Nome" value="@e.Nome" required maxlength="100" class="form-control" /></label><label>UF <input name="Sigla" value="@e.Sigla" required minlength="2" maxlength="2" class="form-control" /></label><label><input name="Ativo" type="checkbox" value="true" checked="@e.Ativo" /> Ativo</label><input name="Ativo" type="hidden" value="false" /><button class="btn btn-primary">Salvar</button></form></details> }
<h2>Cidades</h2>
@foreach (var c in Model.Cidades.Append(new CidadeDto(Guid.Empty, "", Guid.Empty, true))) { <details><summary>@(c.Id == Guid.Empty ? "+ Nova cidade" : c.Nome + (c.Ativo ? "" : " (inativa)"))</summary><form asp-action="Cidade" method="post" class="inline-form"><input name="id" type="hidden" value="@(c.Id == Guid.Empty ? "" : c.Id.ToString())" /><label>Nome <input name="Nome" value="@c.Nome" required maxlength="100" class="form-control" /></label><label>Estado <select name="EstadoId" required class="form-select"><option value="">Selecione</option>@foreach (var e in Model.Estados) { <option value="@e.Id" selected="@(e.Id == c.EstadoId)">@e.Sigla</option> }</select></label><label><input name="Ativo" type="checkbox" value="true" checked="@c.Ativo" /> Ativa</label><input name="Ativo" type="hidden" value="false" /><button class="btn btn-primary">Salvar</button></form></details> }
<h2>Vendedores</h2>
@foreach (var v in Model.Vendedores.Append(new VendedorDto(Guid.Empty, "", "", true))) { <details><summary>@(v.Id == Guid.Empty ? "+ Novo vendedor" : v.Nome + (v.Ativo ? "" : " (inativo)"))</summary><form asp-action="Vendedor" method="post" class="inline-form"><input name="id" type="hidden" value="@(v.Id == Guid.Empty ? "" : v.Id.ToString())" /><label>Nome <input name="Nome" value="@v.Nome" required maxlength="150" class="form-control" /></label><label>E-mail <input name="Email" value="@v.Email" type="email" maxlength="150" class="form-control" /></label><label><input name="Ativo" type="checkbox" value="true" checked="@v.Ativo" /> Ativo</label><input name="Ativo" type="hidden" value="false" /><button class="btn btn-primary">Salvar</button></form></details> }
<p>Crie o login do vendedor em <a asp-controller="Usuarios" asp-action="Index">Acessos</a>.</p>
<h2>Territórios</h2><p>Delimite as áreas pelos nomes. Cada território tem um responsável comercial.</p>
@foreach (var t in Model.Territorios.Append(new TerritorioDto(Guid.Empty, "", Guid.Empty, [], true, 0))) { <details><summary>@(t.Id == Guid.Empty ? "+ Novo território" : t.Nome + (t.Ativo ? "" : " (inativo)"))</summary><form asp-action="Territorio" method="post" class="form-panel"><input name="id" type="hidden" value="@(t.Id == Guid.Empty ? "" : t.Id.ToString())" /><input name="Versao" type="hidden" value="@t.Versao" /><label>Nome <input name="Nome" value="@t.Nome" required maxlength="150" class="form-control" /></label><label>Responsável <select name="VendedorId" required class="form-select"><option value="">Selecione</option>@foreach (var v in Model.Vendedores) { <option value="@v.Id" selected="@(v.Id == t.VendedorId)">@v.Nome</option> }</select></label><label>Cidades (Ctrl para selecionar várias)<select name="CidadeIds" multiple required class="form-select">@foreach (var c in Model.Cidades) { <option value="@c.Id" selected="@t.CidadeIds.Contains(c.Id)">@c.Nome</option> }</select></label><label><input name="Ativo" type="checkbox" value="true" checked="@t.Ativo" /> Ativo</label><input name="Ativo" type="hidden" value="false" /><button class="btn btn-primary">Salvar território</button></form></details> }
