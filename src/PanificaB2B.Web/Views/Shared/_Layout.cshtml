@using PanificaB2B.Contratos
@{
    bool Tem(string perfis) => perfis.Split(',').Any(User.IsInRole);
    var autenticado = User.Identity?.IsAuthenticated == true;
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var perfil = User.IsInRole("Administrador") ? "Administrador" : User.IsInRole("GestorComercial") ? "Gestor comercial" : User.IsInRole("Financeiro") ? "Financeiro" : "Estoque e expedição";
    var menu = new[] { ("Home", "Visão geral", Permissoes.Equipe, "painel"), ("Pedidos", "Pedidos e cortes", Permissoes.Comercial, "pedidos"), ("Clientes", "Clientes", Permissoes.ComercialFinanceiro, "clientes"), ("Roteiros", "Roteiros de visitas", Permissoes.Comercial, "rota"), ("Produtos", "Produtos", Permissoes.Comercial, "produto"), ("Grupos", "Grupos de produtos", Permissoes.Comercial, "grupo"), ("Estoque", "Estoque e validade", Permissoes.Estoque, "estoque"), ("Vendas", "Vendas e entregas", Permissoes.Equipe, "vendas"), ("Financeiro", "Contas a receber", Permissoes.Financeiro, "financeiro"), ("Pagamentos", "Pagamentos", Permissoes.Financeiro, "pagamento"), ("Cadastros", "Cadastros gerais", Permissoes.Comercial, "cadastros"), ("Usuarios", "Acessos", "Administrador", "acessos") };
}
<!DOCTYPE html>
<html lang="pt-BR"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#183f35" />
<title>@ViewData["Title"] · Panifica B2B</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head><body class="@(autenticado ? "app-body" : "auth-body")">
<svg class="icon-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
<symbol id="i-painel" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
<symbol id="i-pedidos" viewBox="0 0 24 24"><path d="M9 4H5v17h14V4h-4M9 2h6v5H9zM8 12h8M8 16h5"/></symbol>
<symbol id="i-clientes" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6M18 15a5 5 0 0 1 3 5"/></symbol>
<symbol id="i-rota" viewBox="0 0 24 24"><circle cx="5" cy="5" r="2"/><circle cx="19" cy="19" r="2"/><path d="M7 5h9a4 4 0 0 1 0 8H8a3 3 0 0 0 0 6h9"/></symbol>
<symbol id="i-produto" viewBox="0 0 24 24"><path d="m3 7 9-4 9 4v10l-9 4-9-4V7Zm0 0 9 4 9-4M12 11v10M7 5l10 4"/></symbol>
<symbol id="i-grupo" viewBox="0 0 24 24"><path d="m12 3 10 5-10 5L2 8l10-5Zm-9 10 9 5 9-5M3 18l9 5 9-5"/></symbol>
<symbol id="i-estoque" viewBox="0 0 24 24"><path d="m2 9 10-6 10 6M4 8v13h16V8M8 21v-9h8v9M8 16h8"/></symbol>
<symbol id="i-vendas" viewBox="0 0 24 24"><path d="M3 5h11v13H3zM14 10h4l3 4v4h-7"/><circle cx="7" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></symbol>
<symbol id="i-financeiro" viewBox="0 0 24 24"><path d="M3 5h18v15H3zM3 9h18M15 13h6v4h-6z"/></symbol>
<symbol id="i-pagamento" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="15" rx="2"/><path d="M2 10h20M6 15h4"/></symbol>
<symbol id="i-cadastros" viewBox="0 0 24 24"><path d="M3 21V7h7v14M10 21V3h11v18M6 11h1M6 15h1M14 7h3M14 11h3M14 15h3M1 21h22"/></symbol>
<symbol id="i-acessos" viewBox="0 0 24 24"><path d="m12 2 8 4v6c0 5-8 10-8 10S4 17 4 12V6l8-4Z"/><path d="m8 12 3 3 5-6"/></symbol>
<symbol id="i-trigo" viewBox="0 0 24 24"><path d="M12 22V5m0 4C5 9 5 4 5 4s7 0 7 5Zm0 6C5 15 5 10 5 10s7 0 7 5Zm0-6c7 0 7-5 7-5s-7 0-7 5Zm0 6c7 0 7-5 7-5s-7 0-7 5ZM12 5c-4-3 0-5 0-5s4 2 0 5Z"/></symbol>
</defs></svg>
<a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
@if (autenticado) {
<aside class="sidebar" id="navegacao">
<a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark"><svg class="icon"><use href="#i-trigo"/></svg></span><span>panifica<span class="brand-subtitle">DISTRIBUIDORA B2B</span></span></a>
<p class="nav-caption">ÁREA DE GESTÃO</p>
<nav aria-label="Navegação principal">@foreach (var item in menu.Where(x=>Tem(x.Item3))) {
<a class="side-link @(controlador == item.Item1 ? "active" : "")" asp-controller="@item.Item1" asp-action="Index" aria-current="@(controlador == item.Item1 ? "page" : null)"><svg class="icon" aria-hidden="true"><use href="#i-@item.Item4"/></svg>@item.Item2</a>
}</nav>
<div class="sidebar-bottom"><span class="status-dot"></span> Operação local<span>Gestão da distribuidora</span></div>
</aside>
<div class="workspace"><header class="topbar"><div class="topbar-location"><button type="button" class="menu-toggle" data-menu-toggle aria-controls="navegacao" aria-expanded="false" aria-label="Abrir menu">☰</button><span>Distribuidora <span class="breadcrumb-divider">/</span> <strong>@ViewData["Title"]</strong></span></div><div class="account"><span class="avatar">@User.Identity!.Name![..1].ToUpperInvariant()</span><span><strong>@User.Identity.Name</strong><small>@perfil</small></span><form asp-controller="Conta" asp-action="Sair" method="post"><button class="logout" type="submit">Sair</button></form></div></header>
<main id="conteudo" class="page-content" tabindex="-1">
@if (TempData["Sucesso"] is string sucesso) { <div class="alert alert-success" role="status">@sucesso</div> }
@if (TempData["Erro"] is string erro) { <div class="alert alert-danger" role="alert">@erro</div> }
@RenderBody()
</main><footer class="app-footer"><span>Panifica B2B</span><span>Faturamento e emissão fiscal simulados · Projeto acadêmico</span></footer></div>
} else {
<main id="conteudo" class="auth-main" tabindex="-1">@RenderBody()</main>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
